{
  "name": "ai-agent-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "通用 AI 智能体应用开发平台 —— 高保真复刻练习项目",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,css,scss,json}\" \"*.{ts,json,js}\""
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "pinia": "^3.0.4",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4",
    "vuetify": "^3.13.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.0",
    "prettier": "^3.9.10",
    "sass-embedded": "^1.107.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.7",
    "vite-plugin-vuetify": "^2.1.3",
    "vue-tsc": "^2.2.12"
  }
}
