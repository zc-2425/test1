# 复制为 server/.env 后按需修改
APP_DEBUG=true
APP_SEED_ON_STARTUP=true

# 数据落盘位置（相对 server/ 或绝对路径）
# APP_DB_PATH=data/app.db
# APP_UPLOAD_DIR=uploads

# P12 真调用才会用到；留空表示走 mock
# APP_DEEPSEEK_API_KEY=
# APP_DEEPSEEK_BASE_URL=https://api.deepseek.com
# ===== 真调用大模型 =====
# auto（默认）：配了 Key 就真调，没配就回落本地模拟；real：强制真调（没 Key 直接报错）；mock：强制模拟
APP_LLM_MODE=auto
APP_LLM_DEFAULT_PROVIDER=deepseek
APP_LLM_DEFAULT_MODEL=deepseek-chat

# 把 Key 填在这里（本文件复制成 .env 后使用；.env 已在 .gitignore 里）
# 三家都走 OpenAI 兼容协议，填哪个就能用哪个
APP_DEEPSEEK_API_KEY=
# APP_OPENAI_API_KEY=
# 本地 Ollama 不需要 Key
# APP_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
